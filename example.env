ENV=development

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=your-opensearch-password
OPENSEARCH_VERIFY_CERTS=false
# Path to the root CA generated by scripts/generate_opensearch_certs.sh — when set,
# TLS is verified against this specific CA instead of disabling verification.
OPENSEARCH_CA_CERT=./certs/opensearch/root-ca.pem

# Ollama (embeddings, and optionally generation)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL_NAME=nomic-embed-text
# Optional local generation model (e.g. llama3.1:8b, gpt-oss:20b — run
# `ollama pull <model>` first). When set, every LLM call tries it first, then
# Groq, then Gemini; blank = Ollama is used for embeddings only. Local models
# follow the citation rules less reliably than GROQ_MODEL_NAME.
OLLAMA_GEN_MODEL=
OLLAMA_CONTEXT_ITEMS=10
OLLAMA_EVIDENCE_CHARS=900

# Groq (text generation)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024

# PostgreSQL
POSTGRES_USER=cancerbot
POSTGRES_DB=cancerbot
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# Redis (arq job queue — background jobs / worker)
REDIS_PASSWORD=your-redis-password
REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:6379/0"

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60000

# Ninja (privileged internal account, created on startup if set; JWT capped at 2h)
NINJA_EMAIL=ninja@example.com
NINJA_PASSWORD=your-ninja-password

# App
# Public frontend origin used in every emailed link. Required when ENV=production.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
PROMPT_MAX_HISTORY=12
# Local dev only: registration skips email verification and "forgot password"
# goes straight to the set-new-password page. Refused when ENV=production.
# Turn it off before running the E2E tests against this backend — they exercise
# the real email flows. (The backend pytest suite forces it off by itself.)
DEV_EMAIL_SHORTCUTS=false

# NLP microservice
NLP_SERVICE_URL=http://localhost:8100
# Cross-encoder reranking of retrieved sources before they reach the LLM —
# set to false to disable without a redeploy (e.g. if nlp-service is under
# load). See src/retrieval/__init__.py:_rerank_sources.
RERANK_ENABLED=true

# Email (Brevo — active provider; see src/utils/email_brevo.py)
BREVO_API_KEY=your-brevo-api-key

# Email (SendGrid — dormant, kept for reference; not currently wired to any sender)
SENDGRID_API_KEY=your-sendgrid-api-key

# Axiom (log ingestion + querying) — separately scoped tokens: WRITE is
# ingest-only (used by the logging handler), READ is query-only (used by
# the daily admin digest's Axiom section, src/jobs/admin_digest.py)
AXIOM_TOKEN_WRITE=your-axiom-ingest-token
AXIOM_TOKEN_READ=your-axiom-query-token
AXIOM_DATASET=cancerbot-logs

# Admin digest emails (daily + weekly usage/health summaries, see src/jobs/admin_digest.py)
# Comma-separated; blank/unset = digests are skipped rather than sent to no one.
ADMIN_DIGEST_EMAILS=admin@example.com

# External APIs
UNPAYWALL_EMAIL=your@email.com

# Google Gemini (second-tier fallback LLM when Groq is unavailable)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Backups (optional — scripts/daily_backup.sh; see requirements-backup.txt)
# BACKUP_S3_BUCKET=your-s3-bucket-name
# GOOGLE_OAUTH_TOKEN_FILE=/path/to/drive_token.json
# generated once via: python scripts/generate_google_drive_token.py --client-secret ... --out ...
# GOOGLE_DRIVE_BACKUP_FOLDER_ID=your-drive-folder-id

# E2E tests (only needed to run e2e/ tests)
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8000
E2E_EMAIL=e2e-test@example.com
E2E_PASSWORD=E2eTest123!

