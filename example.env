ENV=development

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=your-opensearch-password

# Ollama (embeddings)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL_NAME=nomic-embed-text
OLLAMA_CONTEXT_ITEMS=6
OLLAMA_EVIDENCE_CHARS=900

# Groq (text generation)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024

# PostgreSQL
POSTGRES_USER=cancerbot
POSTGRES_DB=cancerbot
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60000

# App
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
PROMPT_MAX_HISTORY=12

# NLP microservice
NLP_SERVICE_URL=http://localhost:8100

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# Sentry
SENTRY_DSN=your-sentry-dsn

# External APIs
UNPAYWALL_EMAIL=your@email.com

# OpenAI (fallback LLM when Groq is unavailable)
OPENAI_API_KEY=your-openai-api-key
OPENAI_FALLBACK_MODEL=gpt-4o-mini
