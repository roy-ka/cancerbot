ENV=development

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=your-opensearch-password
OPENSEARCH_VERIFY_CERTS=false
# Path to the root CA generated by scripts/generate_opensearch_certs.sh — when set,
# TLS is verified against this specific CA instead of disabling verification.
OPENSEARCH_CA_CERT=./certs/opensearch/root-ca.pem

# Ollama (embeddings)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL_NAME=nomic-embed-text
OLLAMA_CONTEXT_ITEMS=10
OLLAMA_EVIDENCE_CHARS=900

# Groq (text generation)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024

# PostgreSQL
POSTGRES_USER=cancerbot
POSTGRES_DB=cancerbot
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60000

# Ninja (privileged internal account, created on startup if set; JWT capped at 2h)
NINJA_EMAIL=ninja@example.com
NINJA_PASSWORD=your-ninja-password

# App
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
PROMPT_MAX_HISTORY=12

# NLP microservice
NLP_SERVICE_URL=http://localhost:8100

# Email (Brevo — active provider; see src/utils/email_brevo.py)
BREVO_API_KEY=your-brevo-api-key

# Email (SendGrid — dormant, kept for reference; not currently wired to any sender)
SENDGRID_API_KEY=your-sendgrid-api-key

# Axiom (log ingestion)
AXIOM_TOKEN=your-axiom-api-token
AXIOM_DATASET=cancerbot-logs

# External APIs
UNPAYWALL_EMAIL=your@email.com

# Google Gemini (second-tier fallback LLM when Groq is unavailable)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Backups (optional — scripts/daily_backup.sh; see requirements-backup.txt)
# BACKUP_S3_BUCKET=your-s3-bucket-name
# GOOGLE_OAUTH_TOKEN_FILE=/path/to/drive_token.json
# generated once via: python scripts/generate_google_drive_token.py --client-secret ... --out ...
# GOOGLE_DRIVE_BACKUP_FOLDER_ID=your-drive-folder-id

# E2E tests (only needed to run e2e/ tests)
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8000
E2E_EMAIL=e2e-test@example.com
E2E_PASSWORD=E2eTest123!

